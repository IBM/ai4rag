# === LLM (MaaS) ===
# MAAS_BASE_URL must end with /v1
MAAS_BASE_URL=
MAAS_API_KEY=
CHAT_BASE_URL=
# Optional override. Leave empty to use MAAS_BASE_URL.
MODEL_ID=__FM_MODEL_ID__
TEMPERATURE=__TEMPERATURE__
MAX_COMPLETION_TOKENS=__MAX_COMPLETION_TOKENS__

# === Generation Prompts ===
# Prompt templates are base64 encoded so multiline values remain valid dotenv entries.
SYSTEM_MESSAGE_B64=__SYSTEM_MESSAGE_B64__
USER_MESSAGE_B64=__USER_MESSAGE_B64__
CONTEXT_TEMPLATE_B64=__CONTEXT_TEMPLATE_B64__
LANGUAGE_CODE=__LANGUAGE_CODE__
LANGUAGE_NAME=__LANGUAGE_NAME__

# === Embedding ===
EMBEDDING_MODEL_ID=__EMBEDDING_MODEL_ID__
EMBEDDING_DIMENSION=__EMBEDDING_DIMENSION__

# === Retrieval ===
RETRIEVAL_METHOD=__RETRIEVAL_METHOD__
NUMBER_OF_CHUNKS=__NUMBER_OF_CHUNKS__
SEARCH_MODE=__SEARCH_MODE__
RANKER_STRATEGY=__RANKER_STRATEGY__
RANKER_ALPHA=__RANKER_ALPHA__

# === Vector Store ===
PROVIDER_TYPE=__PROVIDER_TYPE__

# <<< BEGIN MILVUS >>>
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_COLLECTION_NAME=__COLLECTION_NAME__
MILVUS_SERVER_CERT=
MILVUS_SERVER_NAME=
VECTOR_DB_SECRET_NAME=
# <<< END MILVUS >>>
# <<< BEGIN PGVECTOR >>>
PGVECTOR_HOST=
PGVECTOR_PORT=5432
PGVECTOR_USER=
PGVECTOR_PASSWORD=
PGVECTOR_DATABASE=
PGVECTOR_COLLECTION_NAME=__COLLECTION_NAME__
# <<< END PGVECTOR >>>

# === Deployment ===
CONTAINER_IMAGE=
PORT=8000

# === Optional — MLflow Tracing ===
# MLFLOW_TRACKING_URI=
# MLFLOW_EXPERIMENT_NAME=
# MLFLOW_HEALTH_CHECK_TIMEOUT=5
