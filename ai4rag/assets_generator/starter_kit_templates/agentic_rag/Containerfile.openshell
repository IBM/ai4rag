# openShell sandbox flavor for agentic_rag
#
# Usage:
#   podman build -f Containerfile.openshell -t quay.io/<org>/openshell-agentic-rag:latest .
#   podman push quay.io/<org>/openshell-agentic-rag:latest
#   openshell sandbox create --name rag-sandbox --from quay.io/<org>/openshell-agentic-rag:latest

ARG BASE_IMAGE=ghcr.io/nvidia/openshell-community/sandboxes/base@sha256:aeef1c63f00e2913ea002ccb3aaf925f338b5c5d70e63576f0d95c16a138044e
FROM ${BASE_IMAGE}

USER 0

WORKDIR /sandbox

# Install uv for fast dependency installation
COPY --from=ghcr.io/astral-sh/uv@sha256:fc93e9ecd7218e9ec8fba117af89348eef8fd2463c50c13347478769aaedd0ce /uv /usr/local/bin/uv

COPY --chown=1001:0 pyproject.toml uv.lock ./
COPY --chown=1001:0 src/ ./src/

# Use system Python 3.12 for compatibility (base image has both 3.12 and 3.14)
RUN uv export --frozen --no-dev --extra tracing --no-emit-project --no-hashes > requirements.txt && \
    uv pip install --python /usr/bin/python3.12 --prefix /sandbox/.local --no-cache -r requirements.txt && \
    uv pip install --python /usr/bin/python3.12 --prefix /sandbox/.local --no-cache --no-deps .

# Make Python find packages in /sandbox/.local
ENV PYTHONPATH="/sandbox/.local/lib/python3.12/site-packages:/sandbox/.local/lib64/python3.12/site-packages:$PYTHONPATH"

# Application code and assets
COPY --chown=1001:0 main.py auth_wrapper.py sqlite_shim.py playground_sandbox.py .
COPY --chown=1001:0 playground-sandbox/ ./playground-sandbox/

# Set granular permissions
RUN chmod -R 755 /sandbox && \
    chmod -R 775 /sandbox/.local && \
    find /sandbox -type f -name "*.py" -exec chmod 644 {} \;

# Default user (OpenShell will override this)
USER 1001

ENV PORT=8080

EXPOSE 8080

# NOTE: OpenShell's sandbox supervisor replaces CMD at runtime.
CMD ["uvicorn", "auth_wrapper:app", "--host", "127.0.0.1", "--port", "8080"]
